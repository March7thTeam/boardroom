{
  "name": "boardroom",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run build:web && wrangler dev",
    "dev:api": "wrangler dev",
    "dev:web": "npm --workspace apps/web run dev",
    "build:web": "npm --workspace apps/web run build",
    "build": "npm run build:web",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm --workspace apps/web run typecheck",
    "test": "vitest run",
    "db:migrate": "wrangler d1 migrations apply boardroom_local --local",
    "db:migrate:remote": "wrangler d1 migrations apply boardroom_local --remote",
    "smoke": "node scripts/smoke-s1.mjs",
    "verify-audit": "node scripts/verify-audit.mjs"
  },
  "dependencies": {
    "canonicalize": "^2.1.0",
    "hono": "^4.6.14",
    "ulid": "^2.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "@testing-library/react": "^16.3.3",
    "jsdom": "^30.1.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^4.0.0"
  }
}
